{
  "name": "sanity.eds",
  "private": false,
  "version": "1.3.4",
  "type": "module",
  "description": "AEM Sidekick plugin for Edge Delivery Services (EDS) sites — scans a live page for performance, SEO, security, accessibility, and aem.live-limits issues, with click-to-locate on the actual offending element.",
  "keywords": [
    "aem",
    "edge-delivery-services",
    "eds",
    "franklin",
    "aem-live",
    "aem-sidekick",
    "sidekick-plugin",
    "seo",
    "accessibility",
    "a11y",
    "performance",
    "core-web-vitals",
    "lighthouse",
    "sanity-check",
    "linter",
    "audit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krishna-Mulik/sanity.eds.git"
  },
  "homepage": "https://github.com/Krishna-Mulik/sanity.eds#readme",
  "bugs": {
    "url": "https://github.com/Krishna-Mulik/sanity.eds/issues"
  },
  "files": [
    "dist-plugin",
    "scripts/postinstall.js"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:plugin": "tsc -b && vite build --config vite.plugin.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build:plugin",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.13.3",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "preact": "^10.29.7",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
